  "disposition": [
    {
      "value": "rujuk_segera",
      "reason": "Leptospirosis berat (Weil): rujuk segera untuk penisilin/seftriakson IV & dukungan ginjal.",
      "when": { "traits": ["weil"] }
    },
    {
      "value": "rawat_jalan",
      "reason": "Doksisiklin 2 × 100 mg 7 hari (atau amoksisilin), simptomatik, kontrol 2–3 hari; kembali bila kuning/kencing sedikit.",
      "alsoAccept": ["observasi"]
    }
  ],
  "management": [
    "Ringan: doksisiklin 2 × 100 mg selama 7 hari (amoksisilin/azitromisin bila kontraindikasi).",
    "Parasetamol untuk demam & nyeri; cukup minum, pantau produksi urin.",
    "Berat (Weil): rujuk segera untuk antibiotik IV & tatalaksana gangguan ginjal/perdarahan.",
    "Pencegahan: sepatu bot & sarung tangan, kendalikan tikus, rawat luka."
  ],
  "approach": [
    "Demam akut + mialgia betis + riwayat paparan → curigai leptospirosis.",
    "Nilai tanda Weil; singkirkan dengue & malaria."
  ]
